   Process {
     id: readlinkProc
-    command: ["readlink", "-f", root.currentBackgroundLink]
+    // A theme may ship lock-background.{png,jpg,jpeg,webp}; it is shown sharp.
+    // Otherwise fall back to the blurred desktop background as before.
+    command: ["bash", "-c", "t=\"$1/omarchy/current/theme\"; for f in \"$t\"/lock-background.{png,jpg,jpeg,webp}; do [[ -f $f ]] && { echo \"sharp $(readlink -f \"$f\")\"; exit; }; done; echo \"blur $(readlink -f \"$2\")\"", "lock-bg", root.stateHome, root.currentBackgroundLink]
     stdout: StdioCollector {
       waitForEnd: true
       onStreamFinished: {
-        var next = String(text || "").trim()
-        if (next !== root.backgroundPath) {
+        var out = String(text || "").trim()
+        var space = out.indexOf(" ")
+        var sharp = out.slice(0, space) === "sharp"
+        var next = out.slice(space + 1)
+        if (next !== root.backgroundPath || sharp !== root.sharpBackground) {
+          root.sharpBackground = sharp
           root.backgroundPath = next
           root.backgroundVersion += 1
         }
